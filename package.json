{
	"name": "@siratik/wp-component-library",
	"version": "0.1.0",
	"description": "Library of components for use in the WordPress block editor.",
	"main": "index.js",
	"module": "index.js",
	"exports": {
		".": "./index.js",
		"./editor": "./editor.js",
		"./constants/*": "./constants/*.js"
	},
	"sideEffects": [
		"./components/icon-picker/store.js"
	],
	"scripts": {
		"format": "wp-scripts format",
		"lint:js": "wp-scripts lint-js",
		"lint:md:docs": "wp-scripts lint-md-docs",
		"lint:pkg-json": "wp-scripts lint-pkg-json",
		"test:unit": "wp-scripts test-unit-js components utils"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/builtnorth/wp-component-library.git"
	},
	"author": "Built North",
	"license": "GPL-3.0-or-later",
	"bugs": {
		"url": "https://github.com/builtnorth/wp-component-library/issues"
	},
	"homepage": "https://github.com/builtnorth/wp-component-library#readme",
	"dependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/modifiers": "^9.0.0",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@wordpress/icons": "^15.5.0",
		"classnames": "^2.5.1",
		"dompurify": "^3.4.17",
		"prop-types": "^15.8.1"
	},
	"peerDependencies": {
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.1"
	},
	"devDependencies": {
		"@wordpress/scripts": "^34.2.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1"
	}
}
